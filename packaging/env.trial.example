# Customer / trial .env template — copy to .env next to docker-compose.trial.yml

SECRET_KEY=change-me-use-openssl-rand-hex-32
AURORA_VERSION=0.1.0

# Leave empty for the keyless 30-day trial. After trial, paste the key from sales@zyvor.dev:
# AURORA_LICENSE_KEY=

LLM_PROVIDER=ollama
SEED_DEFAULT_ADMIN=true

# Point these at your backing services (Docker DNS names or host IPs):
DATABASE_URL=postgresql+asyncpg://gtm:gtm_dev@postgres:5432/gtm_platform
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=gtm_dev_neo4j
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=gtm_minio
MINIO_SECRET_KEY=gtm_minio_dev
OLLAMA_BASE_URL=http://ollama:11434/v1
FRONTEND_URL=http://localhost:3000
