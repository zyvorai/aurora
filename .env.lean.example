# Lean hardware preset — 8–16 GB Mac, core team (exec, sales, marketing, partners)
# Copy: cp .env.lean.example .env

# --- Deployment (minimal stack) ---
DEPLOYMENT_PROFILE=minimal
ENABLE_NEO4J=false
ENABLE_REDIS_WORKERS=false
ENABLE_EXTERNAL_CRM_SYNC=false

# --- LLM (single local model) ---
LLM_PROVIDER=ollama
LLM_PROFILE=lean
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_DEFAULT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
OLLAMA_NUM_CTX=8192

# Optional: burst heavy agents to OpenAI without loading extra local models
# LLM_BURST_AGENTS=proposal,market_research
# OPENAI_API_KEY=sk-...

# --- Required services ---
DATABASE_URL=postgresql+asyncpg://gtm:gtm_dev@localhost:5432/gtm_platform
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=gtm_chunks

# Redis optional in minimal profile (workflows use in-process background tasks)
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Pull only 2 models: make ollama-pull-lean
