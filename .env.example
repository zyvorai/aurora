# Database
DATABASE_URL=postgresql+asyncpg://gtm:gtm_dev@localhost:5432/gtm_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=gtm_chunks

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=gtm_dev_neo4j

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=gtm_minio
MINIO_SECRET_KEY=gtm_minio_dev

# SMTP (publishing "email"/"newsletter" channel adapter — see
# apps/api/gtm_api/services/publishing_adapters/email_adapter.py)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=gtm-platform@example.com
# EMAIL_CHANNEL_RECIPIENT=

# OAuth publish-channel adapters (see
# apps/api/gtm_api/services/publishing_adapters/oauth_adapters.py) — each channel
# degrades to "not_configured" until its credentials below are set.
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=
# X_BEARER_TOKEN=
# MEDIUM_ACCESS_TOKEN=
# MEDIUM_AUTHOR_ID=
# DEVTO_API_KEY=
# REDDIT_ACCESS_TOKEN=
# REDDIT_SUBREDDIT=

# SSO (generic OIDC — Auth0, Keycloak, or any OIDC-compliant IdP)
# See docs/sso-oidc.md — Keycloak demo user: demo / demo; local admin: marketing@zyvor.dev / Admin@321
# SSO_ENABLED=true
# SSO_ISSUER=https://your-tenant.us.auth0.com
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/callback
# Keycloak demo IdP: SSO_ISSUER=http://localhost:8180/realms/aurora SSO_CLIENT_ID=aurora

# Consumer social login (Google/GitHub) — auto-provisions a new tenant on first
# sign-in, unlike SSO above. Redirect URIs to register with each provider:
#   Google:  {API_BASE_URL}/api/v1/auth/oauth/google/callback
#   GitHub:  {API_BASE_URL}/api/v1/auth/oauth/github/callback
# API_BASE_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Auth
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# --- LLM Provider (ollama | openai | auto) ---
# Default: ollama. Set OPENAI_API_KEY without LLM_PROVIDER to auto-select openai.
LLM_PROVIDER=ollama

# lean | full — lean uses one chat model for all agents (see .env.lean.example)
LLM_PROFILE=full
# LLM_SINGLE_MODEL=llama3.1:8b
# LLM_BURST_AGENTS=proposal,market_research

# minimal | full — minimal skips Neo4j and Redis workers
DEPLOYMENT_PROFILE=full
# ENABLE_NEO4J=true
# ENABLE_REDIS_WORKERS=true   # when true, make start auto-starts ARQ workers for async source ingest

# Ollama (local, free — default for dev)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_DEFAULT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
OLLAMA_NUM_CTX=8192

# Per-agent Ollama overrides (optional)
# Default profile model is llama3.1:8b (lower RAM). For stronger JSON extraction on 16GB+ RAM:
# AGENT_MODEL_PRODUCT_UNDERSTANDING=qwen2.5-coder:14b
# AGENT_MODEL_MARKETING_STRATEGY=deepseek-r1:8b

# OpenAI (production / premium — fully supported)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Per-agent OpenAI overrides (optional)
# OPENAI_AGENT_MODEL_SALES=gpt-4o-mini
# OPENAI_AGENT_MODEL_MARKETING_STRATEGY=gpt-4o

# MCP context hub — multi-source inputs for LLM decisions
MCP_CONTEXT_ENABLED=true
MCP_EXTERNAL_ENABLED=false
MCP_CONTEXT_PROVIDERS=rag,profile,crm,analytics,brief,leads
MCP_SERVERS=[]
MCP_TIMEOUT_SECONDS=15
MCP_MAX_BLOCKS=8
# Example external MCP server (stdio):
# MCP_EXTERNAL_ENABLED=true
# MCP_SERVERS=[{"name":"docs","type":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-everything"],"tools_allowlist":["echo"]}]

# Frontend (also copied to apps/web/.env.local on make start)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# GTM ops — enrichment, CRM sync, inbound routing
# ENRICHMENT_ENABLED=true
# APOLLO_API_KEY=
# ENABLE_EXTERNAL_CRM_SYNC=false
# EXTERNAL_CRM_PROVIDER=sales_crm
# SALES_CRM_URL=http://localhost:8080
# SALES_CRM_API_KEY=
# HUBSPOT_ACCESS_TOKEN=

# Sales CRM (apps/sales-crm — standalone Go lead/deal-pipeline microservice, `make crm`).
# Independent of the platform's built-in opportunities pipeline
# (apps/api/gtm_api/routers/crm.py) — not wired together. Its own SQLite DB, own env.
# PORT=8080
# CRM_DB=crm.db
# CRM_API_KEY=
# CRM_CORS_ORIGINS=*
# CRM_UI_PASSWORD=
# CRM_UI_SECRET=
# CRM_SLA_HOURS=2
# CRM_OWNERS=

# Licensing (30-day keyless trial; after that set a key from sales@zyvor.dev)
# AURORA_LICENSE_KEY=
# AURORA_LICENSE_ENFORCE=true
