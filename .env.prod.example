# Companion to .env.example for `docker compose -f infra/docker-compose.yml -f docker-compose.prod.yml up -d`.
#
# Copy: cp .env.prod.example .env
#
# Most values are identical to .env.example. The handful of *_URL/*_URI/*_ENDPOINT
# vars that point at backing services are overridden directly in docker-compose.prod.yml
# (container DNS names instead of localhost) -- you do not need to edit those here,
# they're listed below only for reference. Everything else (secrets, LLM provider
# config) is read from this file as-is via env_file:.

# --- Secrets: change these for any real deployment ---
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
POSTGRES_PASSWORD=gtm_dev          # must match infra/docker-compose.yml's postgres service
NEO4J_PASSWORD=gtm_dev_neo4j       # must match infra/docker-compose.yml's neo4j service
MINIO_ACCESS_KEY=gtm_minio
MINIO_SECRET_KEY=gtm_minio_dev

# --- Overridden in docker-compose.prod.yml (kept here for reference only) ---
# DATABASE_URL=postgresql+asyncpg://gtm:gtm_dev@postgres:5432/gtm_platform
# REDIS_URL=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333
# NEO4J_URI=bolt://neo4j:7687
# MINIO_ENDPOINT=minio:9000
# OLLAMA_BASE_URL=http://ollama:11434/v1

# MINIO_ENDPOINT above is container-to-container only (put/get from the api service).
# Presigned download URLs (e.g. the portal-accounts admin document viewer) are opened
# by an admin's browser outside the Docker network, so they need a host the browser can
# actually resolve -- set this to your public host:port for MinIO (the docker-compose
# files already expose 9000-9001). Required for any presigned-URL feature to work
# against a real deployment; leave unset for pure local dev where minio_endpoint is
# already reachable from the browser.
MINIO_PUBLIC_ENDPOINT=your-host-or-domain:9000

QDRANT_COLLECTION=gtm_chunks
NEO4J_USER=neo4j

# --- LLM provider ---
LLM_PROVIDER=ollama
LLM_PROFILE=full
DEPLOYMENT_PROFILE=full
OLLAMA_DEFAULT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
OLLAMA_NUM_CTX=8192
# OPENAI_API_KEY=sk-...

# --- Publishing: email channel adapter (see services/publishing_adapters/email_adapter.py) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- Publishing: OAuth channel adapters (see services/publishing_adapters/oauth_adapters.py) ---
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=
# X_BEARER_TOKEN=
# MEDIUM_ACCESS_TOKEN=
# MEDIUM_AUTHOR_ID=
# DEVTO_API_KEY=
# REDDIT_ACCESS_TOKEN=
# REDDIT_SUBREDDIT=

# --- Keycloak: self-hosted demo IdP (infra/docker-compose.yml's
# keycloak-db/keycloak services). Credentials for those two containers are
# hardcoded dev values directly in infra/docker-compose.yml (same convention
# as postgres/neo4j/minio above, e.g. "gtm_dev") -- not read from this file.

# --- SSO (generic OIDC — Auth0, Keycloak, or any OIDC-compliant IdP) ---
# SSO_ENABLED=true
# SSO_ISSUER=https://your-tenant.us.auth0.com
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_REDIRECT_URI=https://your-domain.example.com/api/v1/auth/sso/callback
# For the self-hosted Keycloak demo IdP instead: SSO_ISSUER=http://<host>:8180/realms/emissary,
# SSO_CLIENT_SECRET must match infra/keycloak/emissary-realm.json's client secret.

# --- Consumer social login (Google/GitHub) — auto-provisions a new tenant on
# first sign-in, unlike SSO above. Register these exact redirect URIs with each
# provider's OAuth app console:
#   Google:  https://your-domain.example.com/api/v1/auth/oauth/google/callback
#   GitHub:  https://your-domain.example.com/api/v1/auth/oauth/github/callback
# API_BASE_URL=https://your-domain.example.com
# FRONTEND_URL=https://your-domain.example.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Frontend build-time value (NOTE: baked into the web image at build,
# not read at container runtime -- must be the externally-reachable URL a
# VISITOR'S BROWSER can reach, e.g. https://your-domain.example.com/api/v1
# or http://YOUR_SERVER_IP:8000/api/v1. Leaving this as "localhost" means
# every visitor's browser tries to call ITS OWN localhost, not your server --
# scripts/deploy-remote.sh refuses to deploy to a remote host with this still
# unset to a real address. ---
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP_OR_DOMAIN:8000/api/v1
