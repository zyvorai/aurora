# Companion to .env.example for `docker compose -f infra/docker-compose.yml -f docker-compose.prod.yml up -d`.
#
# Copy: cp .env.prod.example .env
#
# Most values are identical to .env.example. The handful of *_URL/*_URI/*_ENDPOINT
# vars that point at backing services are overridden directly in docker-compose.prod.yml
# (container DNS names instead of localhost) -- you do not need to edit those here,
# they're listed below only for reference. Everything else (secrets, LLM provider
# config) is read from this file as-is via env_file:.

# --- Secrets: change these for any real deployment ---
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
POSTGRES_PASSWORD=gtm_dev          # must match infra/docker-compose.yml's postgres service
NEO4J_PASSWORD=gtm_dev_neo4j       # must match infra/docker-compose.yml's neo4j service
MINIO_ACCESS_KEY=gtm_minio
MINIO_SECRET_KEY=gtm_minio_dev

# --- Overridden in docker-compose.prod.yml (kept here for reference only) ---
# DATABASE_URL=postgresql+asyncpg://gtm:gtm_dev@postgres:5432/gtm_platform
# REDIS_URL=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333
# NEO4J_URI=bolt://neo4j:7687
# MINIO_ENDPOINT=minio:9000
# OLLAMA_BASE_URL=http://ollama:11434/v1

QDRANT_COLLECTION=gtm_chunks
NEO4J_USER=neo4j

# --- LLM provider ---
LLM_PROVIDER=ollama
LLM_PROFILE=full
DEPLOYMENT_PROFILE=full
OLLAMA_DEFAULT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
OLLAMA_NUM_CTX=8192
# OPENAI_API_KEY=sk-...

# --- Publishing: email channel adapter (see services/publishing_adapters/email_adapter.py) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- Frontend build-time value (NOTE: baked into the web image at build,
# not read at container runtime -- must be the externally-reachable URL,
# e.g. your real domain, not the "api" container DNS name) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
